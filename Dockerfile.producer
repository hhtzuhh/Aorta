FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy entire project
COPY . .

# Set Python path
ENV PYTHONPATH=/app

# Install Python dependencies
RUN pip install --no-cache-dir .

# Create Python script to download database
RUN echo 'import os\n\
from google.cloud import storage\n\
\n\
bucket_name = os.environ["DB_BUCKET"]\n\
print(f"📦 Downloading database from gs://{bucket_name}/mimic_demo.db...")\n\
\n\
client = storage.Client()\n\
bucket = client.bucket(bucket_name)\n\
blob = bucket.blob("mimic_demo.db")\n\
\n\
os.makedirs("/app/_data", exist_ok=True)\n\
blob.download_to_filename("/app/_data/mimic_demo.db")\n\
\n\
if not os.path.exists("/app/_data/mimic_demo.db"):\n\
    print("❌ Database download failed")\n\
    exit(1)\n\
\n\
print("✅ Database ready")\n\
' > /app/download_db.py

# Create startup script
RUN echo '#!/bin/bash\n\
set -e\n\
python /app/download_db.py\n\
echo "🚀 Starting Producer Service on port ${PORT}..."\n\
exec uvicorn producer_service.main:app --host 0.0.0.0 --port ${PORT}\n\
' > /app/start_producer.sh

RUN chmod +x /app/start_producer.sh

# Expose port (Cloud Run will set PORT env var)
EXPOSE 8080

# Run startup script
CMD ["/app/start_producer.sh"]
