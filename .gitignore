# Data files (too large + contains PHI)
_data/
*.db
*.csv
*.csv.gz

# Credentials (NEVER commit!)
credential/
_data/*.json
terraform/*.json
*.pem
*.key
*.env
.env.*

# Terraform sensitive files
terraform/terraform.tfvars
terraform/*.tfstate
terraform/*.tfstate.*
terraform/.terraform/
terraform/.terraform.lock.hcl

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
src/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log

# ML Model Artifacts (generated by training)
ml/models/*/
*.pkl
*.pickle
*.joblib

# ML Evaluation Outputs (plots/visualizations)
ml/**/evaluation/
*.png
*.jpg
*.jpeg

docs/
